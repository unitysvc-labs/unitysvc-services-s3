{
  "currency": "USD",
  "display_name": "S3 Proxy (Bring Your Own Bucket)",
  "documents": {
    "Connectivity test": {
      "$doc_preset": {
        "is_public": false,
        "name": "api_connectivity"
      }
    },
    "How to use this service": {
      "category": "getting_started",
      "description": "How S3 Proxy works and the two ways to use it — one stored bucket (free) or per-enrollment buckets (metered)",
      "file_path": "proxy-byoe-description.md",
      "is_active": true,
      "is_public": true,
      "mime_type": "markdown"
    },
    "Python code example": {
      "category": "code_example",
      "description": "Example code to list and download objects via S3 proxy",
      "file_path": "relay-code-example.py.j2",
      "is_active": true,
      "is_public": true,
      "meta": {
        "output_contains": "connectivity ok",
        "requirements": [
          "boto3"
        ]
      },
      "mime_type": "python"
    }
  },
  "list_price": {
    "channels": {
      "byok": {
        "description": "Free — customer provides own storage",
        "price": "0",
        "type": "constant"
      },
      "plus": {
        "description": "$0.01 per GB transferred",
        "price": "0.01",
        "type": "constant"
      }
    },
    "default": "byok",
    "type": "channel"
  },
  "name": "s3-proxy",
  "service_options": {
    "ops_testing_parameters": {
      "access_key_secret": "S3_RELAY_ACCESS_KEY",
      "bucket": "demo",
      "region": "us-east-1",
      "s3_endpoint": "https://s3.unitysvc.dev",
      "secret_key_secret": "S3_RELAY_SECRET_KEY"
    }
  },
  "status": "ready",
  "time_created": "2026-04-13T00:00:00Z",
  "user_access_interfaces": {
    "enrollment": {
      "access_method": "http",
      "base_url": "${S3_GATEWAY_BASE_URL}/{{ enrollment.code }}"
    },
    "s3_gateway": {
      "access_method": "http",
      "base_url": "${S3_GATEWAY_BASE_URL}/s3-proxy"
    }
  },
  "user_parameters_schema": {
    "properties": {
      "access_key_secret": {
        "description": "Name of the customer secret containing the S3 access key ID",
        "type": "string"
      },
      "bucket": {
        "description": "Bucket name",
        "type": "string"
      },
      "region": {
        "description": "Region (e.g. us-east-1, sfo3)",
        "type": "string"
      },
      "s3_endpoint": {
        "description": "S3-compatible endpoint URL (e.g. https://s3.amazonaws.com, https://sfo3.digitaloceanspaces.com)",
        "type": "string"
      },
      "secret_key_secret": {
        "description": "Name of the customer secret containing the S3 secret access key",
        "type": "string"
      }
    },
    "required": [
      "s3_endpoint",
      "bucket",
      "region",
      "access_key_secret",
      "secret_key_secret"
    ],
    "type": "object"
  }
}
